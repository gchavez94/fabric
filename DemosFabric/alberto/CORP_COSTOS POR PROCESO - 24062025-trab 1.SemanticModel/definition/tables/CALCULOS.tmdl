	measure SACOS =
			
			--Var Moneda = SELECTEDVALUE(Monedas[Moneda])
			Var ImporteML = SUMX(
			       FILTER(
			           h_finanzas_consolidacion,
			           RELATED(dim_cuentas_contables[Partida]) = "Sacos"
			       ),
			       h_finanzas_consolidacion[Importe]
			    )
			Var ImporteMXN = SUMX(
			       FILTER(
			           h_finanzas_consolidacion,
			           RELATED(dim_cuentas_contables[Partida]) = "Sacos"
			       ),
			       h_finanzas_consolidacion[ImporteMXN]
			    )
			Var ImporteUSD = SUMX(
			       FILTER(
			           h_finanzas_consolidacion,
			           RELATED(dim_cuentas_contables[Partida]) = "Sacos"
			       ),
			       h_finanzas_consolidacion[ImporteUSD]
			    )
			RETURN
			SWITCH(
			    [MonedaSeleccionada],
			    "MXN", ImporteMXN,
			    "USD",ImporteUSD,
			     ImporteML)
