			        SUM(h_finanzas_consolidacion[Importe]),
			        USERELATIONSHIP(h_finanzas_consolidacion[SK_B_ProcesoProductivo],dim_b_proceso_productivo[Sk_B_ProcesoProductivo]))
			Return
