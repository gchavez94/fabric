			    CALCULATE(SUM(h_finanzas_consolidacion[Importe]),FILTER(ALL(dim_b_proceso_productivo),dim_b_proceso_productivo[Cve_B_ProcesoProductivo] IN {"101","102","104","105","106","107","108","109"})),
			    
