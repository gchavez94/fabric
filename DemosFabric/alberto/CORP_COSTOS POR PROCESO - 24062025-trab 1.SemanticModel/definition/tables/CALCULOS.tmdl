			Var CostoAbsorbente = SELECTEDVALUE('CostoAbsorbente'[COSTO ABSORBENTE])
			Var HidratacionTotal = [HIDRATACION-111]
			VAr Hidratacion = 
			
			--Moneda Local
			    IF(Depreciacion = "SIN DEPRECIACIÓN" && PTU_Dif = "SIN PTU DIFERIDA" &&CostoAbsorbente = "SIN COSTO ABSORBENTE"
			    &&[MonedaSeleccionada] = "Moneda Local",
			     [Hidratacion_SinDep_SinPTU],
			    
			    IF(Depreciacion = "SIN DEPRECIACIÓN" && PTU_Dif = "CON PTU DIFERIDA" && CostoAbsorbente = "SIN COSTO ABSORBENTE"
			     &&[MonedaSeleccionada] = "Moneda Local",
			     [Hidratacion_SinDep],
			    
			    IF(Depreciacion = "CON DEPRECIACIÓN" && PTU_Dif = "SIN PTU DIFERIDA" && CostoAbsorbente = "SIN COSTO ABSORBENTE"
			     &&[MonedaSeleccionada] = "Moneda Local",
			     [HidratacionSinPTU],
			    
			    IF(Depreciacion = "CON DEPRECIACIÓN" && PTU_Dif = "CON PTU DIFERIDA"  && CostoAbsorbente = "SIN COSTO ABSORBENTE"
			     &&[MonedaSeleccionada] = "Moneda Local",
			     [HIDRATACION-111],
			
			
			--MXN
			    IF(Depreciacion = "SIN DEPRECIACIÓN" && PTU_Dif = "SIN PTU DIFERIDA" &&CostoAbsorbente = "SIN COSTO ABSORBENTE"
			    &&[MonedaSeleccionada] = "MXN",
			     [Hidratacion_SinDep_SinPTU],
			    
			    IF(Depreciacion = "SIN DEPRECIACIÓN" && PTU_Dif = "CON PTU DIFERIDA" && CostoAbsorbente = "SIN COSTO ABSORBENTE"
			     &&[MonedaSeleccionada] = "MXN",
			     [Hidratacion_SinDep],
			    
			    IF(Depreciacion = "CON DEPRECIACIÓN" && PTU_Dif = "SIN PTU DIFERIDA" && CostoAbsorbente = "SIN COSTO ABSORBENTE"
			     &&[MonedaSeleccionada] = "MXN",
			     [HidratacionSinPTU],
			    
			    IF(Depreciacion = "CON DEPRECIACIÓN" && PTU_Dif = "CON PTU DIFERIDA"  && CostoAbsorbente = "SIN COSTO ABSORBENTE"
			     &&[MonedaSeleccionada] = "MXN",
			     [HIDRATACION-111],
			
			
			--USD
			    IF(Depreciacion = "SIN DEPRECIACIÓN" && PTU_Dif = "SIN PTU DIFERIDA" &&CostoAbsorbente = "SIN COSTO ABSORBENTE"
			    &&[MonedaSeleccionada] = "USD",
			     [Hidratacion_SinDep_SinPTU],
			    
			    IF(Depreciacion = "SIN DEPRECIACIÓN" && PTU_Dif = "CON PTU DIFERIDA" && CostoAbsorbente = "SIN COSTO ABSORBENTE"
			     &&[MonedaSeleccionada] = "USD",
			     [Hidratacion_SinDep],
			    
			    IF(Depreciacion = "CON DEPRECIACIÓN" && PTU_Dif = "SIN PTU DIFERIDA" && CostoAbsorbente = "SIN COSTO ABSORBENTE"
			     &&[MonedaSeleccionada] = "USD",
			     [HidratacionSinPTU],
			    
			    IF(Depreciacion = "CON DEPRECIACIÓN" && PTU_Dif = "CON PTU DIFERIDA"  && CostoAbsorbente = "SIN COSTO ABSORBENTE"
			     &&[MonedaSeleccionada] = "USD",
			     [HIDRATACION-111],
			
			---SIN DEPRECIACION - SIN PTU  - CON COSTO ABSORBENTE
			
			    IF(Depreciacion = "SIN DEPRECIACIÓN" && PTU_Dif = "SIN PTU DIFERIDA" && CostoAbsorbente = "CON COSTO ABSORBENTE"
			    &&[MonedaSeleccionada] = "Moneda Local",
			    CALCULATE(SUM(h_finanzas_consolidacion[Importe])-[PTU DIFERIDA]-[DEPRECIACION],FILTER(ALL(dim_b_proceso_productivo),dim_b_proceso_productivo[Cve_B_ProcesoProductivo] IN {"101","102","104","105","106","107","108","109","111"})),
			
			   IF(Depreciacion = "SIN DEPRECIACIÓN" && PTU_Dif = "SIN PTU DIFERIDA" && CostoAbsorbente = "CON COSTO ABSORBENTE"
			    &&[MonedaSeleccionada] = "MXN",
			    CALCULATE(SUM(h_finanzas_consolidacion[ImporteMXN])-[PTU DIFERIDA]-[DEPRECIACION],FILTER(ALL(dim_b_proceso_productivo),dim_b_proceso_productivo[Cve_B_ProcesoProductivo] IN {"101","102","104","105","106","107","108","109","111"})),
			
			       IF(Depreciacion = "SIN DEPRECIACIÓN" && PTU_Dif = "SIN PTU DIFERIDA" && CostoAbsorbente = "CON COSTO ABSORBENTE"
			    &&[MonedaSeleccionada] = "USD",
