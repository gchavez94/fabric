			    &&[MonedaSeleccionada] = "USD",[Trituracion_SinDep],
			    
			    IF(Depreciacion = "CON DEPRECIACIÓN" && PTU_Dif = "SIN PTU DIFERIDA" && CostoAbsorbente = "SIN COSTO ABSORBENTE"
