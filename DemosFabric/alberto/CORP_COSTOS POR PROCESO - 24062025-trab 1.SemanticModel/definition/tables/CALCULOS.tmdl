	measure DEPRECIACION = ```
			
			--Var Moneda = SELECTEDVALUE(Monedas[Moneda])
			Var ImporteML = SUMX(
			       FILTER(
			           h_finanzas_consolidacion,
			           RELATED(dim_cuentas_contables[Partida]) = "Depreciacion"
			       ),
			       h_finanzas_consolidacion[Importe]
			    )
			Var ImporteMXN = SUMX(
			       FILTER(
			           h_finanzas_consolidacion,
			           RELATED(dim_cuentas_contables[Partida]) = "Depreciacion"
			       ),
			       h_finanzas_consolidacion[ImporteMXN]
			    )
			Var ImporteUSD = SUMX(
			       FILTER(
			           h_finanzas_consolidacion,
			           RELATED(dim_cuentas_contables[Partida]) = "Depreciacion"
			       ),
			       h_finanzas_consolidacion[ImporteUSD]
			    )
			RETURN
			SWITCH(
			    [MonedaSeleccionada],
			    "MXN", ImporteMXN,
			    "USD",ImporteUSD,
			     ImporteML)
			  /*VAR FiltroPartida = 
			    FILTER(
			        dim_cuentas_contables,
			        dim_cuentas_contables[Partida] = "Depreciacion"
			    )
			
			VAR Costo = 
			    CALCULATE(
			        SUM(h_finanzas_consolidacion[Importe]),
			        USERELATIONSHIP(h_finanzas_consolidacion[KEY_Cuenta_Contable], dim_cuentas_contables[KEY_Cuenta_Contable]),
			        FiltroPartida
			    )
			RETURN
			Costo*/
