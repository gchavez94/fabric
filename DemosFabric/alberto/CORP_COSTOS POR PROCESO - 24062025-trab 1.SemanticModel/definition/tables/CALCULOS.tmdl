			    CALCULATE(SUM(h_finanzas_consolidacion[Importe])-[DEPRECIACION],FILTER(ALL(dim_b_proceso_productivo),dim_b_proceso_productivo[Cve_B_ProcesoProductivo] IN {"101","102","104","105","106","107","108","109","111"})),
			
			    IF(Depreciacion = "SIN DEPRECIACIÓN" && PTU_Dif = "CON PTU DIFERIDA"&& CostoAbsorbente = "CON COSTO ABSORBENTE"  &&[MonedaSeleccionada] = "MXN",
			    CALCULATE(SUM(h_finanzas_consolidacion[ImporteMXN])-[DEPRECIACION],FILTER(ALL(dim_b_proceso_productivo),dim_b_proceso_productivo[Cve_B_ProcesoProductivo] IN {"101","102","104","105","106","107","108","109","111"})),
			
			    IF(Depreciacion = "SIN DEPRECIACIÓN" && PTU_Dif = "CON PTU DIFERIDA"&& CostoAbsorbente = "CON COSTO ABSORBENTE"  &&[MonedaSeleccionada] = "USD",
			    CALCULATE(SUM(h_finanzas_consolidacion[ImporteUSD])-[DEPRECIACION],FILTER(ALL(dim_b_proceso_productivo),dim_b_proceso_productivo[Cve_B_ProcesoProductivo] IN {"101","102","104","105","106","107","108","109","111"})),
			
			
			-- CON DEPRECIACION  - SIN PTU DIFERIDA - CON COSTO ABSORBENTE
			
			    IF(Depreciacion = "CON DEPRECIACIÓN" && PTU_Dif = "SIN PTU DIFERIDA"&& CostoAbsorbente = "CON COSTO ABSORBENTE"&&[MonedaSeleccionada] = "Moneda Local",
			    CALCULATE(SUM(h_finanzas_consolidacion[Importe])-[PTU DIFERIDA],FILTER(ALL(dim_b_proceso_productivo),dim_b_proceso_productivo[Cve_B_ProcesoProductivo] IN {"101","102","104","105","106","107","108","109","111"})),
			   
			    IF(Depreciacion = "CON DEPRECIACIÓN" && PTU_Dif = "SIN PTU DIFERIDA"&& CostoAbsorbente = "CON COSTO ABSORBENTE"&&[MonedaSeleccionada] = "MXN",
			    CALCULATE(SUM(h_finanzas_consolidacion[ImporteMXN])-[PTU DIFERIDA],FILTER(ALL(dim_b_proceso_productivo),dim_b_proceso_productivo[Cve_B_ProcesoProductivo] IN {"101","102","104","105","106","107","108","109","111"})),
			
			    IF(Depreciacion = "CON DEPRECIACIÓN" && PTU_Dif = "SIN PTU DIFERIDA"&& CostoAbsorbente = "CON COSTO ABSORBENTE"&&[MonedaSeleccionada] = "USD",
			    CALCULATE(SUM(h_finanzas_consolidacion[ImporteUSD])-[PTU DIFERIDA],FILTER(ALL(dim_b_proceso_productivo),dim_b_proceso_productivo[Cve_B_ProcesoProductivo] IN {"101","102","104","105","106","107","108","109","111"})),
			
			-- CON DEPRECIACIÓN - CON PTU  -  CON COSTO ABSORBENTE
			
			    IF(Depreciacion = "CON DEPRECIACIÓN" && PTU_Dif = "CON PTU DIFERIDA"&& CostoAbsorbente = "CON COSTO ABSORBENTE"&&[MonedaSeleccionada] = "Moneda Local",
			    CALCULATE(SUM(h_finanzas_consolidacion[Importe]),FILTER(ALL(dim_b_proceso_productivo),dim_b_proceso_productivo[Cve_B_ProcesoProductivo] IN {"101","102","104","105","106","107","108","109","111"})),
			    
			    IF(Depreciacion = "CON DEPRECIACIÓN" && PTU_Dif = "CON PTU DIFERIDA"&& CostoAbsorbente = "CON COSTO ABSORBENTE"&&[MonedaSeleccionada] = "MXN",
			    CALCULATE(SUM(h_finanzas_consolidacion[ImporteMXN]),FILTER(ALL(dim_b_proceso_productivo),dim_b_proceso_productivo[Cve_B_ProcesoProductivo] IN {"101","102","104","105","106","107","108","109","111"})),
			    
