			    &&[MonedaSeleccionada] = "MXN",
			    CALCULATE(SUM(h_finanzas_consolidacion[ImporteMXN])-[SACOS],FILTER(ALL(dim_b_proceso_productivo),dim_b_proceso_productivo[Cve_B_ProcesoProductivo] IN {"101","102","104","105","106","107","108","109","111","113"})),
			    
			    IF(Depreciacion = "CON DEPRECIACIÓN" && PTU_Dif = "CON PTU DIFERIDA"&& CostoAbsorbente = "CON COSTO ABSORBENTE"&&Sacos = "SIN SACOS"
			    &&[MonedaSeleccionada] = "USD",
			    CALCULATE(SUM(h_finanzas_consolidacion[ImporteUSD])-[SACOS],FILTER(ALL(dim_b_proceso_productivo),dim_b_proceso_productivo[Cve_B_ProcesoProductivo] IN {"101","102","104","105","106","107","108","109","111","113"})),
			
			    [ENVASE-113])
