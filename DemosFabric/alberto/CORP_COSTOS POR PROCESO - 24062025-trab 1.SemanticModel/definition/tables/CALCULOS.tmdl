	measure 'PTU DIFERIDA' = ```
			
			--Var Moneda = SELECTEDVALUE(Monedas[Moneda])
			Var ImporteML = 
			SUMX(
			       FILTER(
			           h_finanzas_consolidacion,
			           h_finanzas_consolidacion[dim_cuentas_contables.Partida] = "PTU Diferida"
			       ),
			       h_finanzas_consolidacion[Importe]
			    )
			
			Var ImporteMXN = 
			SUMX(
			       FILTER(
			           h_finanzas_consolidacion,
			           h_finanzas_consolidacion[dim_cuentas_contables.Partida] = "PTU Diferida"
			       ),
			       h_finanzas_consolidacion[ImporteMXN]
			    )
			Var ImporteUSD = 
			SUMX(
			       FILTER(
			           h_finanzas_consolidacion,
			           h_finanzas_consolidacion[dim_cuentas_contables.Partida] = "PTU Diferida"
			       ),
			       h_finanzas_consolidacion[ImporteUSD]
			    )
			
			Return 
			SWITCH(
			    [MonedaSeleccionada],
			    "MXN", ImporteMXN,
			    "USD",ImporteUSD,
			     ImporteML)
