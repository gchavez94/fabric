	measure COSTO =
			
			Var Depreciacion = SELECTEDVALUE(DEPRECIACION[DEPRECIACIÓN])
			Var PTU_Dif = SELECTEDVALUE('PTU DIFERIDA'[PTU DIFERIDA])
			Var CostoTotal = CALCULATE(SUM(h_finanzas_consolidacion[Importe]))
			VAr Costo = IF(Depreciacion = "SIN DEPRECIACIÓN" && PTU_Dif = "SIN PTU DIFERIDA",CostoTotal-[DEPRECIACION]-[PTU DIFERIDA],
			                     IF( Depreciacion = "SIN DEPRECIACIÓN" && PTU_Dif = "CON PTU DIFERIDA",CostoTotal-[DEPRECIACION],
			                        CostoTotal))
			RETURN
			CostoTotal
		formatString: #,0
		lineageTag: 937ce2b6-40b1-4dd8-9397-746b74674379

