			    if([ProcesoSeleccionado] IN {"Trituracion"},[TRITURACION],IF([ProcesoSeleccionado] IN {"Carbonatos"},[CARBONATOS],
			    if([ProcesoSeleccionado]IN {"Pulverizado de Pet Coke"},[PULVCOKE],IF([ProcesoSeleccionado] IN{"Calcinacion"},[CALCINACION],IF([ProcesoSeleccionado]IN {"Manejo de Cal Viva"},[CALVIVA],IF([ProcesoSeleccionado]IN {"Pulverizado y Envasado de Oxido"},[PULVOXIDO],IF([ProcesoSeleccionado] IN {"Hidratacion y Molienda"},[HIDRATACION],IF([ProcesoSeleccionado] in {"Envase"},[ENVASE],[EXTRACCION]+[TRITURACION]+[CARBONATOS]+[PULVCOKE]+[CALCINACION]+[CALVIVA]+[PULVOXIDO]+[HIDRATACION]+[ENVASE]))))))))),FILTER(ALLSELECTED(dim_b_proceso_productivo),dim_b_proceso_productivo[ClavePP] <= MAX(dim_b_proceso_productivo[ClavePP])))
