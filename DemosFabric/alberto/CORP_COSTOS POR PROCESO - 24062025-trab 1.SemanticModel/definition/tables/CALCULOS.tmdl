			    &&Moneda = "Moneda Local",
			    CALCULATE(SUM(h_finanzas_consolidacion[Importe])-[DEPRECIACION],FILTER(ALL(dim_b_proceso_productivo),dim_b_proceso_productivo[Cve_B_ProcesoProductivo] IN {"101","102"})),
			
			   IF(Depreciacion = "SIN DEPRECIACIÓN" && PTU_Dif = "CON PTU DIFERIDA"&& CostoAbsorbente = "CON COSTO ABSORBENTE"
			    &&Moneda = "MXN",
			    CALCULATE(SUM(h_finanzas_consolidacion[ImporteMXN])-[DEPRECIACION],FILTER(ALL(dim_b_proceso_productivo),dim_b_proceso_productivo[Cve_B_ProcesoProductivo] IN {"101","102"})),
			
