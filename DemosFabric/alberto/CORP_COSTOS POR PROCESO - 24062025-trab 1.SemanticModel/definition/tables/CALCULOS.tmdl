	measure TOTAL = ```
			
			Var Depreciacion = SELECTEDVALUE(DEPRECIACION[DEPRECIACIÓN])
			Var PTU_Dif = SELECTEDVALUE('PTU DIFERIDA'[PTU DIFERIDA])
			Var CostoAbsorbente = SELECTEDVALUE('CostoAbsorbente'[COSTO ABSORBENTE])
			Var A = [EXTRACCION]+[TRITURACION]+[CARBONATOS]+[PULVCOKE]+[CALCINACION]+[CALVIVA]+[PULVOXIDO]+[HIDRATACION]+[ENVASE]
			Var Extraccion = 
			--Moneda Local
			    IF(Depreciacion = "SIN DEPRECIACIÓN" && PTU_Dif = "SIN PTU DIFERIDA"&&CostoAbsorbente = "SIN COSTO ABSORBENTE"&&[MonedaSeleccionada] = "Moneda Local"
			    , [Extraccion_SinDep_SinPTU],
			    
			    IF(Depreciacion = "SIN DEPRECIACIÓN" && PTU_Dif = "CON PTU DIFERIDA"&& CostoAbsorbente = "SIN COSTO ABSORBENTE"&&[MonedaSeleccionada] = "Moneda Local"
			    ,[Extraccion_SinDep],
			    
			    IF(Depreciacion = "CON DEPRECIACIÓN" && PTU_Dif = "SIN PTU DIFERIDA"&& CostoAbsorbente = "SIN COSTO ABSORBENTE"&&[MonedaSeleccionada] = "Moneda Local"
			    ,[ExtraccionSinPTU],
			    
			    IF(Depreciacion = "CON DEPRECIACIÓN" && PTU_Dif = "CON PTU DIFERIDA" && CostoAbsorbente = "SIN COSTO ABSORBENTE"&&[MonedaSeleccionada] = "Moneda Local"
			    ,[EXTRACCION-101],
			    
			    IF(Depreciacion = "SIN DEPRECIACIÓN" && PTU_Dif = "SIN PTU DIFERIDA"&& CostoAbsorbente = "CON COSTO ABSORBENTE"&&[MonedaSeleccionada] = "Moneda Local"
			   ,[Extraccion_SinDep_SinPTU],
			    
			   IF(Depreciacion = "SIN DEPRECIACIÓN" && PTU_Dif = "CON PTU DIFERIDA"&& CostoAbsorbente = "CON COSTO ABSORBENTE"&&[MonedaSeleccionada] = "Moneda Local"
			    ,[Extraccion_SinDep],
			    
			    IF(Depreciacion = "CON DEPRECIACIÓN" && PTU_Dif = "SIN PTU DIFERIDA"&& CostoAbsorbente = "CON COSTO ABSORBENTE"&&[MonedaSeleccionada] = "Moneda Local",[ExtraccionSinPTU],
			   
			    IF(Depreciacion = "CON DEPRECIACIÓN" && PTU_Dif = "CON PTU DIFERIDA"&& CostoAbsorbente = "CON COSTO ABSORBENTE"&&[MonedaSeleccionada] = "Moneda Local"
			    , CALCULATE(SUM(h_finanzas_consolidacion[Importe]),FILTER(ALL(dim_b_proceso_productivo),dim_b_proceso_productivo[Cve_B_ProcesoProductivo] IN {"101"})),
			    
			   --MXN
			    IF(Depreciacion = "SIN DEPRECIACIÓN" && PTU_Dif = "SIN PTU DIFERIDA"&&CostoAbsorbente = "SIN COSTO ABSORBENTE"&&[MonedaSeleccionada] = "MXN"
			    , [Extraccion_SinDep_SinPTU],
			    
			    IF(Depreciacion = "SIN DEPRECIACIÓN" && PTU_Dif = "CON PTU DIFERIDA"&& CostoAbsorbente = "SIN COSTO ABSORBENTE"&&[MonedaSeleccionada] = "MXN"
			    ,[Extraccion_SinDep],
			    
			    IF(Depreciacion = "CON DEPRECIACIÓN" && PTU_Dif = "SIN PTU DIFERIDA"&& CostoAbsorbente = "SIN COSTO ABSORBENTE"&&[MonedaSeleccionada] = "MXN"
			    ,[ExtraccionSinPTU],
			    
			    IF(Depreciacion = "CON DEPRECIACIÓN" && PTU_Dif = "CON PTU DIFERIDA" && CostoAbsorbente = "SIN COSTO ABSORBENTE"&&[MonedaSeleccionada] = "MXN"
			    ,[EXTRACCION-101],
			    
			    IF(Depreciacion = "SIN DEPRECIACIÓN" && PTU_Dif = "SIN PTU DIFERIDA"&& CostoAbsorbente = "CON COSTO ABSORBENTE"&&[MonedaSeleccionada] = "MXN"
			   ,CALCULATE(SUM(h_finanzas_consolidacion[ImporteMXN])-[DEPRECIACION]-[PTU DIFERIDA],FILTER(ALL(dim_b_proceso_productivo),dim_b_proceso_productivo[Cve_B_ProcesoProductivo] IN {"101"})),
			    
			   IF(Depreciacion = "SIN DEPRECIACIÓN" && PTU_Dif = "CON PTU DIFERIDA"&& CostoAbsorbente = "CON COSTO ABSORBENTE"&&[MonedaSeleccionada] = "MXN"
			    ,CALCULATE(SUM(h_finanzas_consolidacion[ImporteMXN])-[DEPRECIACION],FILTER(ALL(dim_b_proceso_productivo),dim_b_proceso_productivo[Cve_B_ProcesoProductivo] IN {"101"})),
			    
			    IF(Depreciacion = "CON DEPRECIACIÓN" && PTU_Dif = "SIN PTU DIFERIDA"&& CostoAbsorbente = "CON COSTO ABSORBENTE"&&[MonedaSeleccionada] = "MXN",
			    CALCULATE(SUM(h_finanzas_consolidacion[ImporteMXN])-[PTU DIFERIDA],FILTER(ALL(dim_b_proceso_productivo),dim_b_proceso_productivo[Cve_B_ProcesoProductivo] IN {"101"})),
			   
			    IF(Depreciacion = "CON DEPRECIACIÓN" && PTU_Dif = "CON PTU DIFERIDA"&& CostoAbsorbente = "CON COSTO ABSORBENTE"&&[MonedaSeleccionada] = "MXN"
			    , CALCULATE(SUM(h_finanzas_consolidacion[ImporteMXN]),FILTER(ALL(dim_b_proceso_productivo),dim_b_proceso_productivo[Cve_B_ProcesoProductivo] IN {"101"})), 
			    
			--USD
			    IF(Depreciacion = "SIN DEPRECIACIÓN" && PTU_Dif = "SIN PTU DIFERIDA"&&CostoAbsorbente = "SIN COSTO ABSORBENTE"&&[MonedaSeleccionada] = "USD"
			    , [Extraccion_SinDep_SinPTU],
			    
			    IF(Depreciacion = "SIN DEPRECIACIÓN" && PTU_Dif = "CON PTU DIFERIDA"&& CostoAbsorbente = "SIN COSTO ABSORBENTE"&&[MonedaSeleccionada] = "USD"
			    ,[Extraccion_SinDep],
			    
			    IF(Depreciacion = "CON DEPRECIACIÓN" && PTU_Dif = "SIN PTU DIFERIDA"&& CostoAbsorbente = "SIN COSTO ABSORBENTE"&&[MonedaSeleccionada] = "USD"
			    ,[ExtraccionSinPTU],
			    
			    IF(Depreciacion = "CON DEPRECIACIÓN" && PTU_Dif = "CON PTU DIFERIDA" && CostoAbsorbente = "SIN COSTO ABSORBENTE"&&[MonedaSeleccionada] = "USD"
			    ,[EXTRACCION-101],
			    
			    IF(Depreciacion = "SIN DEPRECIACIÓN" && PTU_Dif = "SIN PTU DIFERIDA"&& CostoAbsorbente = "CON COSTO ABSORBENTE"&&[MonedaSeleccionada] = "USD"
			   ,CALCULATE(SUM(h_finanzas_consolidacion[ImporteUSD])-[DEPRECIACION]-[PTU DIFERIDA],FILTER(ALL(dim_b_proceso_productivo),dim_b_proceso_productivo[Cve_B_ProcesoProductivo] IN {"101"})),
			    
			   IF(Depreciacion = "SIN DEPRECIACIÓN" && PTU_Dif = "CON PTU DIFERIDA"&& CostoAbsorbente = "CON COSTO ABSORBENTE"&&[MonedaSeleccionada] = "USD"
			    ,CALCULATE(SUM(h_finanzas_consolidacion[ImporteUSD])-[DEPRECIACION],FILTER(ALL(dim_b_proceso_productivo),dim_b_proceso_productivo[Cve_B_ProcesoProductivo] IN {"101"})),
			    
			    IF(Depreciacion = "CON DEPRECIACIÓN" && PTU_Dif = "SIN PTU DIFERIDA"&& CostoAbsorbente = "CON COSTO ABSORBENTE"&&[MonedaSeleccionada] = "USD",
			    CALCULATE(SUM(h_finanzas_consolidacion[ImporteUSD])-[PTU DIFERIDA],FILTER(ALL(dim_b_proceso_productivo),dim_b_proceso_productivo[Cve_B_ProcesoProductivo] IN {"101"})),
			   
			    IF(Depreciacion = "CON DEPRECIACIÓN" && PTU_Dif = "CON PTU DIFERIDA"&& CostoAbsorbente = "CON COSTO ABSORBENTE"&&[MonedaSeleccionada] = "USD"
			    ,CALCULATE(SUM(h_finanzas_consolidacion[ImporteUSD]),FILTER(ALL(dim_b_proceso_productivo),dim_b_proceso_productivo[Cve_B_ProcesoProductivo] IN {"101"})),
			
			
			    [EXTRACCION-101])
			    )))))))))))))))))))))))
			
			VAr Trituracion = 
			
			--Moneda Local
			    IF(Depreciacion = "SIN DEPRECIACIÓN" && PTU_Dif = "SIN PTU DIFERIDA" &&CostoAbsorbente = "SIN COSTO ABSORBENTE"
			    &&[MonedaSeleccionada] = "Moneda Local",
			    [Trituracion_SinDep_SinPTU],
			    
			    IF(Depreciacion = "SIN DEPRECIACIÓN" && PTU_Dif = "CON PTU DIFERIDA" && CostoAbsorbente = "SIN COSTO ABSORBENTE"
			    &&[MonedaSeleccionada] = "Moneda Local",[Trituracion_SinDep],
			    
			    IF(Depreciacion = "CON DEPRECIACIÓN" && PTU_Dif = "SIN PTU DIFERIDA" && CostoAbsorbente = "SIN COSTO ABSORBENTE"
			    &&[MonedaSeleccionada] = "Moneda Local",[TrituracionSinPTU],
			    
			    IF(Depreciacion = "CON DEPRECIACIÓN" && PTU_Dif = "CON PTU DIFERIDA" && CostoAbsorbente = "SIN COSTO ABSORBENTE"
			    &&[MonedaSeleccionada] = "Moneda Local",[TRITURACION-102],
			
			    --MXN
			   IF(Depreciacion = "SIN DEPRECIACIÓN" && PTU_Dif = "SIN PTU DIFERIDA" &&CostoAbsorbente = "SIN COSTO ABSORBENTE"
			    &&[MonedaSeleccionada] = "MXN",
			    [Trituracion_SinDep_SinPTU],
			    
			    IF(Depreciacion = "SIN DEPRECIACIÓN" && PTU_Dif = "CON PTU DIFERIDA" && CostoAbsorbente = "SIN COSTO ABSORBENTE"
			    &&[MonedaSeleccionada] = "MXN",[Trituracion_SinDep],
			    
			    IF(Depreciacion = "CON DEPRECIACIÓN" && PTU_Dif = "SIN PTU DIFERIDA" && CostoAbsorbente = "SIN COSTO ABSORBENTE"
			    &&[MonedaSeleccionada] = "MXN",[TrituracionSinPTU],
			    
			    IF(Depreciacion = "CON DEPRECIACIÓN" && PTU_Dif = "CON PTU DIFERIDA" && CostoAbsorbente = "SIN COSTO ABSORBENTE"
			    &&[MonedaSeleccionada] = "MXN",[TRITURACION-102],
			
			-- USD
			   IF(Depreciacion = "SIN DEPRECIACIÓN" && PTU_Dif = "SIN PTU DIFERIDA" &&CostoAbsorbente = "SIN COSTO ABSORBENTE"
			    &&[MonedaSeleccionada] = "USD",
			    [Trituracion_SinDep_SinPTU],
			    
			    IF(Depreciacion = "SIN DEPRECIACIÓN" && PTU_Dif = "CON PTU DIFERIDA" && CostoAbsorbente = "SIN COSTO ABSORBENTE"
			    &&[MonedaSeleccionada] = "USD",[Trituracion_SinDep],
			    
			    IF(Depreciacion = "CON DEPRECIACIÓN" && PTU_Dif = "SIN PTU DIFERIDA" && CostoAbsorbente = "SIN COSTO ABSORBENTE"
			    &&[MonedaSeleccionada] = "USD",[TrituracionSinPTU],
			    
			    IF(Depreciacion = "CON DEPRECIACIÓN" && PTU_Dif = "CON PTU DIFERIDA" && CostoAbsorbente = "SIN COSTO ABSORBENTE"
			    &&[MonedaSeleccionada] = "USD",[TRITURACION-102],
			
			
			
			  ---SIN DEPRECIACION - SIN PTU  - CON COSTO ABSORBENTE
			    IF(Depreciacion = "SIN DEPRECIACIÓN" && PTU_Dif = "SIN PTU DIFERIDA" && CostoAbsorbente = "CON COSTO ABSORBENTE"
			    &&[MonedaSeleccionada] = "Moneda Local"
			    ,CALCULATE(SUM(h_finanzas_consolidacion[Importe])-[PTU DIFERIDA]-[DEPRECIACION],FILTER(ALL(dim_b_proceso_productivo),dim_b_proceso_productivo[Cve_B_ProcesoProductivo] IN {"101","102"})),
			    
			    IF(Depreciacion = "SIN DEPRECIACIÓN" && PTU_Dif = "SIN PTU DIFERIDA" && CostoAbsorbente = "CON COSTO ABSORBENTE"
			    &&[MonedaSeleccionada] = "MXN"
			    ,CALCULATE(SUM(h_finanzas_consolidacion[ImporteMXN])-[PTU DIFERIDA]-[DEPRECIACION],FILTER(ALL(dim_b_proceso_productivo),dim_b_proceso_productivo[Cve_B_ProcesoProductivo] IN {"101","102"})),
			
			    IF(Depreciacion = "SIN DEPRECIACIÓN" && PTU_Dif = "SIN PTU DIFERIDA" && CostoAbsorbente = "CON COSTO ABSORBENTE"
			    &&[MonedaSeleccionada] = "USD"
			    ,CALCULATE(SUM(h_finanzas_consolidacion[ImporteUSD])-[PTU DIFERIDA]-[DEPRECIACION],FILTER(ALL(dim_b_proceso_productivo),dim_b_proceso_productivo[Cve_B_ProcesoProductivo] IN {"101","102"})),
			
			
			
			-- SIN DEPRECIACION  - CON PTU - CON COSTO ABSORBENTE
			   IF(Depreciacion = "SIN DEPRECIACIÓN" && PTU_Dif = "CON PTU DIFERIDA"&& CostoAbsorbente = "CON COSTO ABSORBENTE"
			    &&[MonedaSeleccionada] = "Moneda Local",
			    CALCULATE(SUM(h_finanzas_consolidacion[Importe])-[DEPRECIACION],FILTER(ALL(dim_b_proceso_productivo),dim_b_proceso_productivo[Cve_B_ProcesoProductivo] IN {"101","102"})),
			
			   IF(Depreciacion = "SIN DEPRECIACIÓN" && PTU_Dif = "CON PTU DIFERIDA"&& CostoAbsorbente = "CON COSTO ABSORBENTE"
			    &&[MonedaSeleccionada] = "MXN",
			    CALCULATE(SUM(h_finanzas_consolidacion[ImporteMXN])-[DEPRECIACION],FILTER(ALL(dim_b_proceso_productivo),dim_b_proceso_productivo[Cve_B_ProcesoProductivo] IN {"101","102"})),
			
			    IF(Depreciacion = "SIN DEPRECIACIÓN" && PTU_Dif = "CON PTU DIFERIDA"&& CostoAbsorbente = "CON COSTO ABSORBENTE"
			    &&[MonedaSeleccionada] = "USD",
			    CALCULATE(SUM(h_finanzas_consolidacion[ImporteUSD])-[DEPRECIACION],FILTER(ALL(dim_b_proceso_productivo),dim_b_proceso_productivo[Cve_B_ProcesoProductivo] IN {"101","102"})),
			
			-- CON DEPRECIACION  - SIN PTU DIFERIDA - CON COSTO ABSORBENTE
			    IF(Depreciacion = "CON DEPRECIACIÓN" && PTU_Dif = "SIN PTU DIFERIDA"&& CostoAbsorbente = "CON COSTO ABSORBENTE"
			    &&[MonedaSeleccionada] = "Moneda Local",
			    CALCULATE(SUM(h_finanzas_consolidacion[Importe])-[PTU DIFERIDA],FILTER(ALL(dim_b_proceso_productivo),dim_b_proceso_productivo[Cve_B_ProcesoProductivo] IN {"101","102"})),
			
			   IF(Depreciacion = "CON DEPRECIACIÓN" && PTU_Dif = "SIN PTU DIFERIDA"&& CostoAbsorbente = "CON COSTO ABSORBENTE"
			    &&[MonedaSeleccionada] = "MXN",
			    CALCULATE(SUM(h_finanzas_consolidacion[ImporteMXN])-[PTU DIFERIDA],FILTER(ALL(dim_b_proceso_productivo),dim_b_proceso_productivo[Cve_B_ProcesoProductivo] IN {"101","102"})),
			
			    IF(Depreciacion = "CON DEPRECIACIÓN" && PTU_Dif = "SIN PTU DIFERIDA"&& CostoAbsorbente = "CON COSTO ABSORBENTE"
			    &&[MonedaSeleccionada] = "USD",
			    CALCULATE(SUM(h_finanzas_consolidacion[ImporteUSD])-[PTU DIFERIDA],FILTER(ALL(dim_b_proceso_productivo),dim_b_proceso_productivo[Cve_B_ProcesoProductivo] IN {"101","102"})),
			
			
			-- CON DEPRECIACIÓN - CON PTU  -  CON COSTO ABSORBENTE
			   
			    IF(Depreciacion = "CON DEPRECIACIÓN" && PTU_Dif = "CON PTU DIFERIDA"&& CostoAbsorbente = "CON COSTO ABSORBENTE"
			    &&[MonedaSeleccionada] = "Moneda Local"
			    ,CALCULATE(SUM(h_finanzas_consolidacion[Importe]),FILTER(ALL(dim_b_proceso_productivo),dim_b_proceso_productivo[Cve_B_ProcesoProductivo] IN {"101","102"})),
			    
			    IF(Depreciacion = "CON DEPRECIACIÓN" && PTU_Dif = "CON PTU DIFERIDA"&& CostoAbsorbente = "CON COSTO ABSORBENTE"
			    &&[MonedaSeleccionada] = "MXN"
			    ,CALCULATE(SUM(h_finanzas_consolidacion[ImporteMXN]),FILTER(ALL(dim_b_proceso_productivo),dim_b_proceso_productivo[Cve_B_ProcesoProductivo] IN {"101","102"})),
			    
			    IF(Depreciacion = "CON DEPRECIACIÓN" && PTU_Dif = "CON PTU DIFERIDA"&& CostoAbsorbente = "CON COSTO ABSORBENTE"
			    &&[MonedaSeleccionada] = "USD"
			    ,CALCULATE(SUM(h_finanzas_consolidacion[ImporteUSD]),FILTER(ALL(dim_b_proceso_productivo),dim_b_proceso_productivo[Cve_B_ProcesoProductivo] IN {"101","102"})), [TRITURACION-102])
			    )))))))))))))))))))))))
			
			VAr Carbonatos = 
			--Moneda Local
			    IF(Depreciacion = "SIN DEPRECIACIÓN" && PTU_Dif = "SIN PTU DIFERIDA"&&CostoAbsorbente = "SIN COSTO ABSORBENTE"
			    &&[MonedaSeleccionada] = "Moneda Local",
			    [Carbonatos_SinDep_SinPTU],
			    
			    IF(Depreciacion = "SIN DEPRECIACIÓN" && PTU_Dif = "CON PTU DIFERIDA" && CostoAbsorbente = "SIN COSTO ABSORBENTE"
			     &&[MonedaSeleccionada] = "Moneda Local"
			    ,[Carbonatos_SinDep],
			    
			    IF(Depreciacion = "CON DEPRECIACIÓN" && PTU_Dif = "SIN PTU DIFERIDA" && CostoAbsorbente = "SIN COSTO ABSORBENTE"
			     &&[MonedaSeleccionada] = "Moneda Local"
			    ,[CarbonatosSinPTU],
			    
			    IF(Depreciacion = "CON DEPRECIACIÓN" && PTU_Dif = "CON PTU DIFERIDA" && CostoAbsorbente = "SIN COSTO ABSORBENTE" 
			     &&[MonedaSeleccionada] = "Moneda Local"
			    ,[CARBONATOS-104],
			    
			    --MXN
			      IF(Depreciacion = "SIN DEPRECIACIÓN" && PTU_Dif = "SIN PTU DIFERIDA"&&CostoAbsorbente = "SIN COSTO ABSORBENTE"
			    &&[MonedaSeleccionada] = "MXN",
			    [Carbonatos_SinDep_SinPTU],
			    
			    IF(Depreciacion = "SIN DEPRECIACIÓN" && PTU_Dif = "CON PTU DIFERIDA" && CostoAbsorbente = "SIN COSTO ABSORBENTE"
			     &&[MonedaSeleccionada] = "MXN"
			    ,[Carbonatos_SinDep],
			    
			    IF(Depreciacion = "CON DEPRECIACIÓN" && PTU_Dif = "SIN PTU DIFERIDA" && CostoAbsorbente = "SIN COSTO ABSORBENTE"
			     &&[MonedaSeleccionada] = "MXN"
			    ,[CarbonatosSinPTU],
			    
			    IF(Depreciacion = "CON DEPRECIACIÓN" && PTU_Dif = "CON PTU DIFERIDA" && CostoAbsorbente = "SIN COSTO ABSORBENTE" 
			     &&[MonedaSeleccionada] = "MXN"
			    ,[CARBONATOS-104],
			
			--USD
			      IF(Depreciacion = "SIN DEPRECIACIÓN" && PTU_Dif = "SIN PTU DIFERIDA"&&CostoAbsorbente = "SIN COSTO ABSORBENTE"
			    &&[MonedaSeleccionada] = "USD",
			    [Carbonatos_SinDep_SinPTU],
			    
			    IF(Depreciacion = "SIN DEPRECIACIÓN" && PTU_Dif = "CON PTU DIFERIDA" && CostoAbsorbente = "SIN COSTO ABSORBENTE"
			     &&[MonedaSeleccionada] = "USD"
			    ,[Carbonatos_SinDep],
			    
			    IF(Depreciacion = "CON DEPRECIACIÓN" && PTU_Dif = "SIN PTU DIFERIDA" && CostoAbsorbente = "SIN COSTO ABSORBENTE"
			     &&[MonedaSeleccionada] = "USD"
			    ,[CarbonatosSinPTU],
			    
			    IF(Depreciacion = "CON DEPRECIACIÓN" && PTU_Dif = "CON PTU DIFERIDA" && CostoAbsorbente = "SIN COSTO ABSORBENTE" 
			     &&[MonedaSeleccionada] = "USD"
			    ,[CARBONATOS-104],
			
			
			   ---SIN DEPRECIACION - SIN PTU  - CON COSTO ABSORBENTE   
			    IF(Depreciacion = "SIN DEPRECIACIÓN" && PTU_Dif = "SIN PTU DIFERIDA" && CostoAbsorbente = "CON COSTO ABSORBENTE" &&[MonedaSeleccionada] = "Moneda Local"
			    ,CALCULATE(SUM(h_finanzas_consolidacion[Importe])-[PTU DIFERIDA]-[DEPRECIACION],FILTER(ALL(dim_b_proceso_productivo),dim_b_proceso_productivo[Cve_B_ProcesoProductivo] IN {"101","102","104"})),
			
			     IF(Depreciacion = "SIN DEPRECIACIÓN" && PTU_Dif = "SIN PTU DIFERIDA" && CostoAbsorbente = "CON COSTO ABSORBENTE" &&[MonedaSeleccionada] = "MXN"
			    ,CALCULATE(SUM(h_finanzas_consolidacion[ImporteMXN])-[PTU DIFERIDA]-[DEPRECIACION],FILTER(ALL(dim_b_proceso_productivo),dim_b_proceso_productivo[Cve_B_ProcesoProductivo] IN {"101","102","104"})),
			
			     IF(Depreciacion = "SIN DEPRECIACIÓN" && PTU_Dif = "SIN PTU DIFERIDA" && CostoAbsorbente = "CON COSTO ABSORBENTE" &&[MonedaSeleccionada] = "USD"
			    ,CALCULATE(SUM(h_finanzas_consolidacion[ImporteUSD])-[PTU DIFERIDA]-[DEPRECIACION],FILTER(ALL(dim_b_proceso_productivo),dim_b_proceso_productivo[Cve_B_ProcesoProductivo] IN {"101","102","104"})),
			
			-- SIN DEPRECIACION  - CON PTU - CON COSTO ABSORBENTE    
			    IF(Depreciacion = "SIN DEPRECIACIÓN" && PTU_Dif = "CON PTU DIFERIDA"&& CostoAbsorbente = "CON COSTO ABSORBENTE"&&[MonedaSeleccionada] = "Moneda Local",
			    CALCULATE(SUM(h_finanzas_consolidacion[Importe])-[DEPRECIACION],FILTER(ALL(dim_b_proceso_productivo),dim_b_proceso_productivo[Cve_B_ProcesoProductivo] IN {"101","102","104"})),
			    
			    IF(Depreciacion = "SIN DEPRECIACIÓN" && PTU_Dif = "CON PTU DIFERIDA"&& CostoAbsorbente = "CON COSTO ABSORBENTE"&&[MonedaSeleccionada] = "MXN",
			    CALCULATE(SUM(h_finanzas_consolidacion[ImporteMXN])-[DEPRECIACION],FILTER(ALL(dim_b_proceso_productivo),dim_b_proceso_productivo[Cve_B_ProcesoProductivo] IN {"101","102","104"})),
			
			     IF(Depreciacion = "SIN DEPRECIACIÓN" && PTU_Dif = "CON PTU DIFERIDA"&& CostoAbsorbente = "CON COSTO ABSORBENTE"&&[MonedaSeleccionada] = "USD",
			    CALCULATE(SUM(h_finanzas_consolidacion[ImporteUSD])-[DEPRECIACION],FILTER(ALL(dim_b_proceso_productivo),dim_b_proceso_productivo[Cve_B_ProcesoProductivo] IN {"101","102","104"})),
			
			
			-- CON DEPRECIACION  - SIN PTU DIFERIDA - CON COSTO ABSORBENTE
			
			    IF(Depreciacion = "CON DEPRECIACIÓN" && PTU_Dif = "SIN PTU DIFERIDA"&& CostoAbsorbente = "CON COSTO ABSORBENTE"&&[MonedaSeleccionada] = "Moneda Local",
			    CALCULATE(SUM(h_finanzas_consolidacion[Importe])-[PTU DIFERIDA],FILTER(ALL(dim_b_proceso_productivo),dim_b_proceso_productivo[Cve_B_ProcesoProductivo] IN {"101","102","104"})),
			
			    IF(Depreciacion = "CON DEPRECIACIÓN" && PTU_Dif = "SIN PTU DIFERIDA"&& CostoAbsorbente = "CON COSTO ABSORBENTE"
			    &&[MonedaSeleccionada] = "MXN",
			    CALCULATE(SUM(h_finanzas_consolidacion[ImporteMXN])-[PTU DIFERIDA],FILTER(ALL(dim_b_proceso_productivo),dim_b_proceso_productivo[Cve_B_ProcesoProductivo] IN {"101","102","104"})),
			
			    IF(Depreciacion = "CON DEPRECIACIÓN" && PTU_Dif = "SIN PTU DIFERIDA"&& CostoAbsorbente = "CON COSTO ABSORBENTE"&&[MonedaSeleccionada] = "USD",
			    CALCULATE(SUM(h_finanzas_consolidacion[ImporteUSD])-[PTU DIFERIDA],FILTER(ALL(dim_b_proceso_productivo),dim_b_proceso_productivo[Cve_B_ProcesoProductivo] IN {"101","102","104"})),
			
			
			-- CON DEPRECIACIÓN - CON PTU  -  CON COSTO ABSORBENTE
			  
			    IF(Depreciacion = "CON DEPRECIACIÓN" && PTU_Dif = "CON PTU DIFERIDA"&& CostoAbsorbente = "CON COSTO ABSORBENTE"&&[MonedaSeleccionada] = "Moneda Local",
			    CALCULATE(SUMX(h_finanzas_consolidacion,h_finanzas_consolidacion[Importe]),FILTER(ALL(dim_b_proceso_productivo),dim_b_proceso_productivo[Cve_B_ProcesoProductivo] IN {"101","102","104"})),
			    
			     IF(Depreciacion = "CON DEPRECIACIÓN" && PTU_Dif = "CON PTU DIFERIDA"&& CostoAbsorbente = "CON COSTO ABSORBENTE"&&[MonedaSeleccionada] = "MXN",
			     CALCULATE(SUM(h_finanzas_consolidacion[ImporteMXN]),FILTER(ALL(dim_b_proceso_productivo),dim_b_proceso_productivo[Cve_B_ProcesoProductivo] IN {"101","102","104"})),
			    
			     IF(Depreciacion = "CON DEPRECIACIÓN" && PTU_Dif = "CON PTU DIFERIDA"&& CostoAbsorbente = "CON COSTO ABSORBENTE"&&[MonedaSeleccionada] = "USD",
			     CALCULATE(SUM(h_finanzas_consolidacion[ImporteUSD]),FILTER(ALL(dim_b_proceso_productivo),dim_b_proceso_productivo[Cve_B_ProcesoProductivo] IN {"101","102","104"}))
			    
			    
			    ,[CARBONATOS-104])
			    )))))))))))))))))))))))
			Var C =
			IF([ProcesoSeleccionado] = "Extraccion y Acarreo", [EXTRACCION],
			 if([ProcesoSeleccionado] IN {"Extraccion y Acarreo, Trituracion"},Extraccion+Trituracion,
			    if([ProcesoSeleccionado] IN {"Carbonatos, Extraccion y Acarreo"},Extraccion+Carbonatos,
			    if([ProcesoSeleccionado] IN {"Trituracion"},[TRITURACION],
			    IF([ProcesoSeleccionado] IN {"Carbonatos"},[CARBONATOS],
			    IF([ProcesoSeleccionado] IN {"Carbonatos, Extraccion y Acarreo, Trituracion"},Extraccion+Trituracion+Carbonatos,
			    if([ProcesoSeleccionado]IN {"Pulverizado de Pet Coke"},[PULVCOKE],IF([ProcesoSeleccionado] IN{"Calcinacion"},[CALCINACION],IF([ProcesoSeleccionado]IN {"Manejo de Cal Viva"},[CALVIVA],IF([ProcesoSeleccionado]IN {"Pulverizado y Envasado de Oxido"},[PULVOXIDO],IF([ProcesoSeleccionado] IN {"Hidratacion y Molienda"},[HIDRATACION],IF([ProcesoSeleccionado] in {"Envase"},[ENVASE],[EXTRACCION]+[TRITURACION]+[CARBONATOS]+[PULVCOKE]+[CALVIVA]+[PULVOXIDO]))))))))))))
			
			RETURN
			C
			```
