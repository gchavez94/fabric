			    [HIDRATACION-111])
			    )))))))))))))))))))))))
			                        
			         -- IF(Depreciacion = "CON DEPRECIACIÓN" && PTU_Dif = "CON PTU DIFERIDA"&&CostoAbsorbente = "CON COSTO --ABSORBENTE",[EXTRACCION-101_ML]+[TRITURACION-102_ML],1000)              
