	measure EXTRACCION = ```
			
			Var Depreciacion = SELECTEDVALUE(DEPRECIACION[DEPRECIACIÓN])
			Var PTU_Dif = SELECTEDVALUE('PTU DIFERIDA'[PTU DIFERIDA])
			Var CostoAbsorbente = SELECTEDVALUE('CostoAbsorbente'[COSTO ABSORBENTE])
			Var ExtraccionTotal = [EXTRACCION-101]
			VAr Extraccion = 
			--Moneda Local
			    IF(Depreciacion = "SIN DEPRECIACIÓN" && PTU_Dif = "SIN PTU DIFERIDA"&&CostoAbsorbente = "SIN COSTO ABSORBENTE"&&[MonedaSeleccionada] = "Moneda Local"
			    , [Extraccion_SinDep_SinPTU],
			    
			    IF(Depreciacion = "SIN DEPRECIACIÓN" && PTU_Dif = "CON PTU DIFERIDA"&& CostoAbsorbente = "SIN COSTO ABSORBENTE"&&[MonedaSeleccionada] = "Moneda Local"
			    ,[Extraccion_SinDep],
			    
			    IF(Depreciacion = "CON DEPRECIACIÓN" && PTU_Dif = "SIN PTU DIFERIDA"&& CostoAbsorbente = "SIN COSTO ABSORBENTE"&&[MonedaSeleccionada] = "Moneda Local"
			    ,[ExtraccionSinPTU],
			    
			    IF(Depreciacion = "CON DEPRECIACIÓN" && PTU_Dif = "CON PTU DIFERIDA" && CostoAbsorbente = "SIN COSTO ABSORBENTE"&&[MonedaSeleccionada] = "Moneda Local"
			    ,[EXTRACCION-101],
			    
			    IF(Depreciacion = "SIN DEPRECIACIÓN" && PTU_Dif = "SIN PTU DIFERIDA"&& CostoAbsorbente = "CON COSTO ABSORBENTE"&&[MonedaSeleccionada] = "Moneda Local"
			   ,[Extraccion_SinDep_SinPTU],
			    
			   IF(Depreciacion = "SIN DEPRECIACIÓN" && PTU_Dif = "CON PTU DIFERIDA"&& CostoAbsorbente = "CON COSTO ABSORBENTE"&&[MonedaSeleccionada] = "Moneda Local"
			    ,[Extraccion_SinDep],
			    
			    IF(Depreciacion = "CON DEPRECIACIÓN" && PTU_Dif = "SIN PTU DIFERIDA"&& CostoAbsorbente = "CON COSTO ABSORBENTE"&&[MonedaSeleccionada] = "Moneda Local",[ExtraccionSinPTU],
			   
			    IF(Depreciacion = "CON DEPRECIACIÓN" && PTU_Dif = "CON PTU DIFERIDA"&& CostoAbsorbente = "CON COSTO ABSORBENTE"&&[MonedaSeleccionada] = "Moneda Local"
			    , CALCULATE(SUM(h_finanzas_consolidacion[Importe]),FILTER(ALL(dim_b_proceso_productivo),dim_b_proceso_productivo[Cve_B_ProcesoProductivo] IN {"101"})),
			    
			   --MXN
			    IF(Depreciacion = "SIN DEPRECIACIÓN" && PTU_Dif = "SIN PTU DIFERIDA"&&CostoAbsorbente = "SIN COSTO ABSORBENTE"&&[MonedaSeleccionada] = "MXN"
			    , [Extraccion_SinDep_SinPTU],
			    
			    IF(Depreciacion = "SIN DEPRECIACIÓN" && PTU_Dif = "CON PTU DIFERIDA"&& CostoAbsorbente = "SIN COSTO ABSORBENTE"&&[MonedaSeleccionada] = "MXN"
			    ,[Extraccion_SinDep],
			    
			    IF(Depreciacion = "CON DEPRECIACIÓN" && PTU_Dif = "SIN PTU DIFERIDA"&& CostoAbsorbente = "SIN COSTO ABSORBENTE"&&[MonedaSeleccionada] = "MXN"
			    ,[ExtraccionSinPTU],
			    
			    IF(Depreciacion = "CON DEPRECIACIÓN" && PTU_Dif = "CON PTU DIFERIDA" && CostoAbsorbente = "SIN COSTO ABSORBENTE"&&[MonedaSeleccionada] = "MXN"
			    ,[EXTRACCION-101],
			    
			    IF(Depreciacion = "SIN DEPRECIACIÓN" && PTU_Dif = "SIN PTU DIFERIDA"&& CostoAbsorbente = "CON COSTO ABSORBENTE"&&[MonedaSeleccionada] = "MXN"
			   ,CALCULATE(SUM(h_finanzas_consolidacion[ImporteMXN])-[DEPRECIACION]-[PTU DIFERIDA],FILTER(ALL(dim_b_proceso_productivo),dim_b_proceso_productivo[Cve_B_ProcesoProductivo] IN {"101"})),
			    
			   IF(Depreciacion = "SIN DEPRECIACIÓN" && PTU_Dif = "CON PTU DIFERIDA"&& CostoAbsorbente = "CON COSTO ABSORBENTE"&&[MonedaSeleccionada] = "MXN"
			    ,CALCULATE(SUM(h_finanzas_consolidacion[ImporteMXN])-[DEPRECIACION],FILTER(ALL(dim_b_proceso_productivo),dim_b_proceso_productivo[Cve_B_ProcesoProductivo] IN {"101"})),
			    
			    IF(Depreciacion = "CON DEPRECIACIÓN" && PTU_Dif = "SIN PTU DIFERIDA"&& CostoAbsorbente = "CON COSTO ABSORBENTE"&&[MonedaSeleccionada] = "MXN",
			    CALCULATE(SUM(h_finanzas_consolidacion[ImporteMXN])-[PTU DIFERIDA],FILTER(ALL(dim_b_proceso_productivo),dim_b_proceso_productivo[Cve_B_ProcesoProductivo] IN {"101"})),
			   
			    IF(Depreciacion = "CON DEPRECIACIÓN" && PTU_Dif = "CON PTU DIFERIDA"&& CostoAbsorbente = "CON COSTO ABSORBENTE"&&[MonedaSeleccionada] = "MXN"
			    , CALCULATE(SUM(h_finanzas_consolidacion[ImporteMXN]),FILTER(ALL(dim_b_proceso_productivo),dim_b_proceso_productivo[Cve_B_ProcesoProductivo] IN {"101"})), 
			    
			--USD
			    IF(Depreciacion = "SIN DEPRECIACIÓN" && PTU_Dif = "SIN PTU DIFERIDA"&&CostoAbsorbente = "SIN COSTO ABSORBENTE"&&[MonedaSeleccionada] = "USD"
			    , [Extraccion_SinDep_SinPTU],
			    
			    IF(Depreciacion = "SIN DEPRECIACIÓN" && PTU_Dif = "CON PTU DIFERIDA"&& CostoAbsorbente = "SIN COSTO ABSORBENTE"&&[MonedaSeleccionada] = "USD"
			    ,[Extraccion_SinDep],
			    
			    IF(Depreciacion = "CON DEPRECIACIÓN" && PTU_Dif = "SIN PTU DIFERIDA"&& CostoAbsorbente = "SIN COSTO ABSORBENTE"&&[MonedaSeleccionada] = "USD"
			    ,[ExtraccionSinPTU],
			    
			    IF(Depreciacion = "CON DEPRECIACIÓN" && PTU_Dif = "CON PTU DIFERIDA" && CostoAbsorbente = "SIN COSTO ABSORBENTE"&&[MonedaSeleccionada] = "USD"
			    ,[EXTRACCION-101],
			    
			    IF(Depreciacion = "SIN DEPRECIACIÓN" && PTU_Dif = "SIN PTU DIFERIDA"&& CostoAbsorbente = "CON COSTO ABSORBENTE"&&[MonedaSeleccionada] = "USD"
			   ,CALCULATE(SUM(h_finanzas_consolidacion[ImporteUSD])-[DEPRECIACION]-[PTU DIFERIDA],FILTER(ALL(dim_b_proceso_productivo),dim_b_proceso_productivo[Cve_B_ProcesoProductivo] IN {"101"})),
			    
			   IF(Depreciacion = "SIN DEPRECIACIÓN" && PTU_Dif = "CON PTU DIFERIDA"&& CostoAbsorbente = "CON COSTO ABSORBENTE"&&[MonedaSeleccionada] = "USD"
			    ,CALCULATE(SUM(h_finanzas_consolidacion[ImporteUSD])-[DEPRECIACION],FILTER(ALL(dim_b_proceso_productivo),dim_b_proceso_productivo[Cve_B_ProcesoProductivo] IN {"101"})),
			    
			    IF(Depreciacion = "CON DEPRECIACIÓN" && PTU_Dif = "SIN PTU DIFERIDA"&& CostoAbsorbente = "CON COSTO ABSORBENTE"&&[MonedaSeleccionada] = "USD",CALCULATE(SUM(h_finanzas_consolidacion[ImporteUSD])-[PTU DIFERIDA],FILTER(ALL(dim_b_proceso_productivo),dim_b_proceso_productivo[Cve_B_ProcesoProductivo] IN {"101"})),
			   
			    IF(Depreciacion = "CON DEPRECIACIÓN" && PTU_Dif = "CON PTU DIFERIDA"&& CostoAbsorbente = "CON COSTO ABSORBENTE"&&[MonedaSeleccionada] = "USD"
			    ,CALCULATE(SUM(h_finanzas_consolidacion[ImporteUSD]),FILTER(ALL(dim_b_proceso_productivo),dim_b_proceso_productivo[Cve_B_ProcesoProductivo] IN {"101"})),
			
			
			    [EXTRACCION-101])
			    )))))))))))))))))))))))
			                        
			   
			Return
			Extraccion
			```
		formatString: \$#,0.###############;(\$#,0.###############);\$#,0.###############
		lineageTag: 349ff1dc-9363-4cb0-a4b4-a1137146c422

