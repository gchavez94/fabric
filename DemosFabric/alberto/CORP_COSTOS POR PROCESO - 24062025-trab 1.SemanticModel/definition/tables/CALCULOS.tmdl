	measure 'PTU DIFERIDA_ABSORBENTE' = ```
			
			VAR PTU =
			   SUMX (
			        FILTER ( ALLSELECTED ( 'PROCESOS' ), 'PROCESOS'[ORDEN] <=2),
			        CALCULATE(SUM(h_finanzas_consolidacion[Importe]),
			        FILTER(
			           h_finanzas_consolidacion,
			           RELATED(dim_cuentas_contables[Partida]) = "PTU Diferida")
			       )
			       
			    )
			
			RETURN
			PTU
			
			/*SUMX(FILTER('InternetSales_USD', RELATED('SalesTerritory'[SalesTerritoryCountry])<>"United States")
			     ,'InternetSales_USD'[SalesAmount_USD])*/
			```
