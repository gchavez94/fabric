	measure CATrituración =
			
			VAR Extraccion = CALCULATE([PruebaCosto], h_finanzas_consolidacion[ProcesoProductivo] = "101")
			VAR Trituracion = CALCULATE([PruebaCosto], h_finanzas_consolidacion[ProcesoProductivo] = "102")
			
			RETURN
			Extraccion + Trituracion
