	measure HIDRATACION-111 = ```
			
			 VAR ImporteML =  CALCULATE(SUM(h_finanzas_consolidacion[Importe]),FILTER(h_finanzas_consolidacion,h_finanzas_consolidacion[ProcesoProductivo] = "111"))
			 VAR ImporteMXN =  CALCULATE(SUM(h_finanzas_consolidacion[ImporteMXN]),FILTER(h_finanzas_consolidacion,h_finanzas_consolidacion[ProcesoProductivo] = "111"))
			
			 VAR ImporteUSD =  CALCULATE(SUM(h_finanzas_consolidacion[ImporteUSD]),FILTER(h_finanzas_consolidacion,h_finanzas_consolidacion[ProcesoProductivo] = "111"))
			
			RETURN
			SWITCH(
			    [MonedaSeleccionada],
			    "MXN", ImporteMXN,
			    "USD",ImporteUSD,
			     ImporteML)
