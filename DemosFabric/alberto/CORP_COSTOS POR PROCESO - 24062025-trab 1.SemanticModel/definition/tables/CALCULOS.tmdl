	measure MonedaSeleccionada = SELECTEDVALUE(Monedas[Moneda])
		lineageTag: b098e9c8-5b5d-47fc-899c-4669e8243838

	measure PeridoActual = CONCATENATE(YEAR(TODAY()),MONTH(TODAY()))
		lineageTag: 752d342e-cf7e-4ecc-87b6-e31d9a6ec12f

	measure TnProducidas = ```
			
			--Extraccion
			Var Extraccion = CALCULATE(sum(h_operaciones[Cantidad]),LEFT(h_operaciones[Cve_Articulo_Producido],3) = "40-"&&h_operaciones[Cve_B_ProcesoProductivo] = "101") 
			Var Trituracion = CALCULATE(sum(h_operaciones[Cantidad]),LEFT(h_operaciones[Cve_Articulo_Producido],3) = "40-"&&h_operaciones[Cve_B_ProcesoProductivo] = "102",h_operaciones[Fecha_Fisica]<= TODAY())
			Var Carbonatos = CALCULATE(sum(h_operaciones[Cantidad]),LEFT(h_operaciones[Cve_Articulo_Producido],3) = "40-"&&h_operaciones[Cve_B_ProcesoProductivo] = "104",h_operaciones[Fecha_Fisica]<= TODAY())
			Var PulvPetCoke = CALCULATE(sum(h_operaciones[Cantidad]),LEFT(h_operaciones[Cve_Articulo_Producido],3) <> "41-"&&h_operaciones[Cve_B_ProcesoProductivo] IN {"105","106"},h_operaciones[Fecha_Fisica]<= TODAY())
			Var Calcinacion = CALCULATE(sum(h_operaciones[Cantidad]),LEFT(h_operaciones[Cve_Articulo_Producido],3) = "40-"&&h_operaciones[Cve_B_ProcesoProductivo] = "107",h_operaciones[Fecha_Fisica]<= TODAY())
			Var CalViva = CALCULATE(sum(h_operaciones[Cantidad]),LEFT(h_operaciones[Cve_Articulo_Producido],3) = "40-"&&h_operaciones[Cve_B_ProcesoProductivo] = "108",h_operaciones[Fecha_Fisica]<= TODAY())
			Var PulvOxido = CALCULATE(sum(h_operaciones[Cantidad]),LEFT(h_operaciones[Cve_Articulo_Producido],3) = "40-"&&h_operaciones[Cve_B_ProcesoProductivo] = "109",h_operaciones[Fecha_Fisica]<= TODAY())
			Var Hidroxido = CALCULATE(sum(h_operaciones[Cantidad]),LEFT(h_operaciones[Cve_Articulo_Producido],3) = "40-"&&h_operaciones[Cve_B_ProcesoProductivo] = "111",h_operaciones[Fecha_Fisica]<= TODAY())
			Var Envase = CALCULATE(sum(h_operaciones[Cantidad]),LEFT(h_operaciones[Cve_Articulo_Producido],3) = "40-"&&h_operaciones[Cve_B_ProcesoProductivo] = "113",h_operaciones[Fecha_Fisica]<= TODAY())
			Var TnProducidas = Extraccion + Trituracion + Carbonatos + PulvPetCoke + Calcinacion + CalViva + PulvOxido + Hidroxido +Envase
			Return
			IF(TnProducidas=0,0,TnProducidas)
			```
