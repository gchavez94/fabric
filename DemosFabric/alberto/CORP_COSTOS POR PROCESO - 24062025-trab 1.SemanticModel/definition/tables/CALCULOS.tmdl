			    &&Moneda = "MXN"
			    ,CALCULATE(SUM(h_finanzas_consolidacion[ImporteMXN])-[PTU DIFERIDA]-[DEPRECIACION],FILTER(ALL(dim_b_proceso_productivo),dim_b_proceso_productivo[Cve_B_ProcesoProductivo] IN {"101","102"})),
			
			    IF(Depreciacion = "SIN DEPRECIACIÓN" && PTU_Dif = "SIN PTU DIFERIDA" && CostoAbsorbente = "CON COSTO ABSORBENTE"
