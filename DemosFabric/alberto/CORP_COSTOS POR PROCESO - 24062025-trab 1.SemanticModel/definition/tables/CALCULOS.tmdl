	measure ProcesoSeleccionado =
			IF(
			    ISFILTERED(dim_b_proceso_productivo[Dsc_B_ProcesoProductivo]),
			       CONCATENATEX(
			           VALUES(dim_b_proceso_productivo[Dsc_B_ProcesoProductivo]),
			           dim_b_proceso_productivo[Dsc_B_ProcesoProductivo],
			            ", ",
			            dim_b_proceso_productivo[Dsc_B_ProcesoProductivo],ASC
