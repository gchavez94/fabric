table CALCULOS
	lineageTag: bba7cc7c-a2b2-459b-af8f-90ec432c5e10

	measure EXTRACCION-101 =
			
			Var Moneda = SELECTEDVALUE(Monedas[Moneda])
			Var ImporteML = CALCULATE(SUM(h_finanzas_consolidacion[Importe]),FILTER(h_finanzas_consolidacion,h_finanzas_consolidacion[ProcesoProductivo] = "101"))
			VAR ImporteMXN = CALCULATE(SUM(h_finanzas_consolidacion[ImporteMXN]),FILTER(h_finanzas_consolidacion,h_finanzas_consolidacion[ProcesoProductivo] = "101"))
			Var ImporteUSD = CALCULATE(SUM(h_finanzas_consolidacion[ImporteUSD]),FILTER(h_finanzas_consolidacion,h_finanzas_consolidacion[ProcesoProductivo] = "101"))
			RETURN
			SWITCH(
			    Moneda,
			    "MXN", ImporteMXN,
			    "USD",ImporteUSD,
			     ImporteML)
		lineageTag: 6ae13918-0c5c-4264-ab9e-15834c8a8bfa

		annotation PBI_FormatHint = {"isGeneralNumber":true}

