				let
				    Origen = Sql.Database("eu2-cal-syn-ws-prd-ondemand.sql.azuresynapse.net", "svr", [Query="   Select SK_Compania,HO.Cve_Compania,#(lf)  HO.SK_A_Localidad,Cve_B_ProcesoProductivo,SK_B_ProcesoProductivo, SK_C_Recurso,#(lf)      Fecha_Fisica, LEft(CONVERT(varchar, Fecha_Financiera, 112),6) Periodo,Cve_Articulo_Producido,Sum(Cantidad) Cantidad #(lf)From H_Operaciones HO#(lf)--Left Join dim_a_localidad L ON HO.Sk_A_Localidad = HO.Sk_A_Localidad#(lf)Where Cve_TipoTransaccion= 2#(lf)Group By#(lf)SK_Compania,HO.Cve_Compania,HO.Sk_A_Localidad,Cve_B_ProcesoProductivo, SK_B_ProcesoProductivo,SK_C_Recurso,#(lf)      Fecha_Fisica,Fecha_Financiera,Cve_Articulo_Producido"]),
