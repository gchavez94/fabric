				    #"Se expandió dim_b_proceso_productivo" = Table.ExpandTableColumn(#"Consultas combinadas2", "dim_b_proceso_productivo", {"Dsc_B_ProcesoProductivo"}, {"dim_b_proceso_productivo.Dsc_B_ProcesoProductivo"})
