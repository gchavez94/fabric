	partition DIM_CATALOGO_MP = m
		mode: import
		source =
				let
				    Origen = Sql.Database("10.20.128.105", "DWH_LM", [Query="SELECT#(lf)    MIN([Orden]) AS Orden,#(lf)    Concepto,#(lf)    MIN(Concepto) AS detalle#(lf)FROM [DWH_LM].[dbo].[CATALOGO_MP]#(lf)WHERE Concepto IS NOT NULL#(lf)GROUP BY Concepto#(lf)order by orden asc;"])
				in
				    Origen

