  <DataSets>
    <DataSet Name="DataSet1">
      <Query>
        <DataSourceName>Ferrovalle</DataSourceName>
        <CommandText>DEFINE VAR __DS0Core = 
	SUMMARIZECOLUMNS(
		ROLLUPADDISSUBTOTAL(
			ROLLUPGROUP(
				'BD Dwell Carros activos v1'[Entidad emisora],
				'BD Dwell Carros activos v1'[Entidad receptora],
				'BD Dwell Carros activos v1'[Id Mov],
				'Capacidad patios'[Patio]
			), "IsGrandTotalRowTotal"
		),
		"SumHoras_posic_lib", CALCULATE(SUM('BD Dwell Carros activos v1'[Horas posic-lib]))
	)

EVALUATE
	__DS0Core

ORDER BY
	[IsGrandTotalRowTotal] DESC,
	'BD Dwell Carros activos v1'[Entidad emisora],
	'BD Dwell Carros activos v1'[Entidad receptora],
	'BD Dwell Carros activos v1'[Id Mov],
	'Capacidad patios'[Patio]</CommandText>
        <wa:PreviewCommandText>DEFINE
	VAR __DS0Core = 
		SUMMARIZECOLUMNS(
			ROLLUPADDISSUBTOTAL(
				ROLLUPGROUP(
					'BD Dwell Carros activos v1'[Entidad emisora],
					'BD Dwell Carros activos v1'[Entidad receptora],
					'BD Dwell Carros activos v1'[Id Mov],
					'Capacidad patios'[Patio]
				), "IsGrandTotalRowTotal"
			),
			"SumHoras_posic_lib", CALCULATE(SUM('BD Dwell Carros activos v1'[Horas posic-lib]))
		)

	VAR __DS0BodyLimited = 
		TOPN(
			500,
			__DS0Core,
			[IsGrandTotalRowTotal],
			0,
			'BD Dwell Carros activos v1'[Entidad emisora],
			1,
			'BD Dwell Carros activos v1'[Entidad receptora],
			1,
			'BD Dwell Carros activos v1'[Id Mov],
			1,
			'Capacidad patios'[Patio],
			1
		)

EVALUATE
	__DS0BodyLimited

ORDER BY
	[IsGrandTotalRowTotal] DESC,
	'BD Dwell Carros activos v1'[Entidad emisora],
	'BD Dwell Carros activos v1'[Entidad receptora],
	'BD Dwell Carros activos v1'[Id Mov],
	'Capacidad patios'[Patio]</wa:PreviewCommandText>
      </Query>
