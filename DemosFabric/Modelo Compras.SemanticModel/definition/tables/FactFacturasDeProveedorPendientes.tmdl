	measure M_ConteoRecepcionesPendientesPorFacturas = DISTINCTCOUNT(FactFacturasDeProveedorPendientes[IdOrdenDeCompra])
		formatString: 0
		lineageTag: c7b2cfaa-7350-46c5-bde0-5ced98c05642

	measure M_MontoDeFacturaPendiente = ```
			
			Var SeleccionMoneda=SELECTEDVALUE(DimMoneda[Id])
			Var MontoMXN=SUM(FactFacturasDeProveedorPendientes[MontoDeFacturaImportada])
			Var MontoUSD=SUM(FactFacturasDeProveedorPendientes[MontoDeFacturaImportadaUSD])
			Var Resultado=IF(SeleccionMoneda=1,MontoMXN,MontoUSD)
			RETURN Resultado
			
			```
		lineageTag: 3793d80b-b5c7-40a2-a90f-d24540f13108

		annotation PBI_FormatHint = {"isGeneralNumber":true}

