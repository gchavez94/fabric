table FactFacturasProveedorAbiertas
	lineageTag: 95d76093-7d05-4e9f-a427-f3c2a315cae8

	measure M_ConteoFacturasAbiertas = ```
			DISTINCTCOUNT(FactFacturasProveedorAbiertas[Factura])
			
			
			```
		formatString: 0
		lineageTag: ddc086d4-6486-4a9b-bca0-c76f258859b9

	measure M_MontoFacturaAbierta = ```
			
			Var SeleccionMoneda=SELECTEDVALUE(DimMoneda[Id])
			Var MontoMXN=SUM(FactFacturasProveedorAbiertas[MontoDeFacturaMXN])
			Var MontoUSD=SUM(FactFacturasProveedorAbiertas[MontoDeFacturaUSD])
			Var Resultado=IF(SeleccionMoneda=1,MontoMXN,MontoUSD)
			RETURN Resultado
			
			```
		lineageTag: e6ab6a5d-c81a-4efb-9028-4ff1a0ee9e64

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure M_MontoNoLiquidadoFacturaAbierta = ```
			
			Var SeleccionMoneda=SELECTEDVALUE(DimMoneda[Id])
			Var MontoUSD=SUM(FactFacturasProveedorAbiertas[MontoNoLiquidadoUSD])
			Var MontoMXN=SUM(FactFacturasProveedorAbiertas[MontoNoLiquidadoMXN])
			Var Resultado=IF(SeleccionMoneda=1,MontoMXN,MontoUSD)
			RETURN Resultado
			
			```
		lineageTag: 93222dd1-4661-4f4b-aece-7daa0efddcf7

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure M_TiempoPromedio_FACTCXP_OC = ```
			CALCULATE(AVERAGEX(
			    FactFacturasProveedorAbiertas,FactFacturasProveedorAbiertas[FechaDeRegistroVto]-RELATED(DimOrdenDeCompra[FechaCreacion])
			    ),FactFacturasProveedorAbiertas[IdOrdenDeCompra] <> "")
			
			```
		lineageTag: 7f58af2b-5183-495d-8a64-6d866c8a0ba1

