table FactPagosFacturas
	lineageTag: 81309e08-005d-441a-87b6-b88319f89f63

	measure M_MontoLiquidadoPagoFactura = ```
			
			Var SeleccionMoneda=SELECTEDVALUE(DimMoneda[Id])
			Var MontoMXN=SUM(FactPagosFacturas[MontoLiquidadoMXN])
			Var MontoUSD=SUM(FactPagosFacturas[MontoLiquidadoUSD])
			Var Resultado=IF(SeleccionMoneda=1,MontoMXN,MontoUSD)
			RETURN Resultado
			
			```
		lineageTag: 733e4926-dcf2-457a-bb94-2062669be451

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure M_ConteoFacturasPagadas = ```
			
			CALCULATE(DISTINCTCOUNT(FactPagosFacturas[Factura]),FactPagosFacturas[FechaDeCierre]> DATE(1900,1,1))
			
			```
		formatString: 0
		lineageTag: 7ba970d2-77e9-458c-973e-56a74b3c1bd7

	measure M_MontoFacturaPago = ```
			
			Var SeleccionMoneda=SELECTEDVALUE(DimMoneda[Id])
			Var MontoMXN=SUM(FactPagosFacturas[MontoDeFacturaMXN])
			Var MontoUSD=SUM(FactPagosFacturas[MontoDeFacturaUSD])
			Var Resultado=IF(SeleccionMoneda=1,MontoMXN,MontoUSD)
			RETURN Resultado
			
			```
		lineageTag: edb6ab54-5f26-42be-99cf-64058eead672

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure M_TiempoPromedio_Recepcion_Factura = ```
			AVERAGEX(SELECTCOLUMNS(SUMMARIZE(FILTER(FactPagosFacturas,FactPagosFacturas[IdOrdenDeCompra] <> "" && FactPagosFacturas[MaxFechaRecepcion] > DATE(1900,1,1)),FactPagosFacturas[IdOrdenDeCompra],FactPagosFacturas[Factura],"Recepcion",MAX(FactPagosFacturas[MaxFechaRecepcion]),"RegistroFactura",MAX(FactPagosFacturas[FechaTransaccion])),[Recepcion],[RegistroFactura]),[RegistroFactura]-[Recepcion])
			
			```
		lineageTag: 0d7988e1-f19d-464f-ae60-1e0e8d2c0f00

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure M_TiempoPromedioPagoFactura = ```
			
			AVERAGEX(SELECTCOLUMNS(SUMMARIZE(FILTER(FactPagosFacturas,FactPagosFacturas[FechaDeCierre]> DATE(1900,1,1)
			 && NOT(ISBLANK(FactPagosFacturas[IdOrdenDeCompra]))
			 ),FactPagosFacturas[IdOrdenDeCompra],FactPagosFacturas[Factura],"UltimoPago",MAX(FactPagosFacturas[FechaUltimoPago]),"ConfirmacionFactura",MAX(FactPagosFacturas[MaxFechaRecepcion])),[UltimoPago],[ConfirmacionFactura]),[UltimoPago]-[ConfirmacionFactura])
			
			```
		lineageTag: df9f8262-ca41-466e-bd17-9e466abed22b

		annotation PBI_FormatHint = {"isGeneralNumber":true}

