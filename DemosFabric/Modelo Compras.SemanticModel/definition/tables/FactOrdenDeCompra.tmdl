table FactOrdenDeCompra
	lineageTag: ebf160b5-c5e2-458f-a28b-04643b9f2ddc

	measure M_ConteoOrdenDeCompra = CALCULATE(COUNT(FactSolicitudDeCompraRequisicion[IdOrdenDeCompraLinea]),FactSolicitudDeCompraRequisicion[IdOrdenDeCompraLinea] <> "NO APLICA")
		formatString: 0
		lineageTag: a4939c9c-0f8e-4b63-a1e0-397c3878982a

	measure M_MontoNetoOrdenDeCompra = ```
			
			 Var SeleccionMoneda=SELECTEDVALUE(DimMoneda[Id])
			Var MontoMXN=SUM(FactOrdenDeCompra[MontoNetoMXN])
			Var MontoUSD=SUM(FactOrdenDeCompra[MontoNetoUSD])
			Var Resultado=IF(SeleccionMoneda=1,MontoMXN,MontoUSD)
			RETURN Resultado
			```
		lineageTag: 5f806b0a-d2e0-4c81-886d-8f6d3f4674f4

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure M_MontoNetoOrdenDeCompraImpuesto = ```
			
			 Var SeleccionMoneda=SELECTEDVALUE(DimMoneda[Id])
			Var MontoMXN=SUM(FactOrdenDeCompra[MontoNetoMXNImpuesto])
			Var MontoUSD=SUM(FactOrdenDeCompra[MontoNetoUSDImpuesto])
			Var Resultado=IF(SeleccionMoneda=1,MontoMXN,MontoUSD)
			RETURN Resultado
			```
		lineageTag: 0748d6bf-3ca8-4fec-8843-c15c1a29f173

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure M_TiempoPromedio_OC_Recepcion = ```
			
			 AVERAGEX(SELECTCOLUMNS(SUMMARIZE(FILTER(FactOrdenDeCompra,FactOrdenDeCompra[FechaRecepcion] > DATE(1900,1,1 )),FactOrdenDeCompra[IdOrdenDeCompra],"Recepcion",MAX(FactOrdenDeCompra[FechaRecepcion]),"RegistroOC",MAX(FactOrdenDeCompra[FechaDeCreacionOrdenDeCompra])),[Recepcion],[RegistroOC]),[Recepcion]-[RegistroOC])
			```
		lineageTag: 00803cb2-2da4-4175-985b-7df5d8bbb6e9

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure M_TiempoPromedio_SDCR_OC =
			
			
			CALCULATE(
			AVERAGEX(
			    FactOrdenDeCompra,FactOrdenDeCompra[FechaDeCreacionOrdenDeCompra]
			    -FactOrdenDeCompra[FechaDeCreacionSolicitud])
			
			    ,FactOrdenDeCompra[IdSolicitudDeCompraRequisicion]<> "NO APLICA",FactOrdenDeCompra[IdOrdenDeCompra]<> "")
		lineageTag: 3a064a1b-95f9-4910-9c9d-d47c1deab9ec

		annotation PBI_FormatHint = {"isGeneralNumber":true}

